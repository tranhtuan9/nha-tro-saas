// Hệ thống quản lý nhà trọ SaaS Multi-tenant — 15 bảng
// Các ràng buộc DBML không diễn đạt được (CHECK, partial unique index, RLS) nằm trong Note và AGENTS.md.

Enum tenant_status { ACTIVE  SUSPENDED }
Enum user_role { ADMIN  LANDLORD  RENTER }
Enum user_status { ACTIVE  LOCKED }
Enum room_status { AVAILABLE  OCCUPIED  MAINTENANCE }
Enum contract_status { ACTIVE  ENDED  TERMINATED }
Enum invoice_status { UNPAID  PAID  OVERDUE  CANCELLED }
Enum payment_status { PENDING  PAID  CANCELLED  FAILED }
Enum audit_source { USER  AI }
Enum audit_status { PROPOSED  CONFIRMED  REJECTED  EXECUTED  FAILED }
Enum support_type { COMPLAINT  REPAIR  OTHER }
Enum support_status { OPEN  IN_PROGRESS  RESOLVED }

// ---------- NỀN TẢNG SAAS ----------
Table Plan {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  max_properties int [not null]
  max_rooms int [not null]
  price decimal(12,0) [not null]
  duration_days int [not null]
  is_active boolean [not null, default: true, note: 'Ẩn gói thay vì xóa (UC06)']
  created_at timestamptz [not null, default: `now()`]
  Note: 'Gói dịch vụ SaaS. Cấu hình DEFAULT_PLAN_NAME chọn gói mặc định khi Landlord đăng ký.'
}

Table Tenant {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  plan_id uuid [not null]
  status tenant_status [not null, default: 'ACTIVE']
  subscription_start date [not null]
  subscription_end date [not null]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Tạo tự động khi Landlord đăng ký (UC08). id chính là tenant_id ở các bảng khác.'
}

Table User {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [null, note: 'NULL khi role = ADMIN']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  phone varchar(20)
  national_id varchar(20)
  role user_role [not null]
  status user_status [not null, default: 'ACTIVE']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, phone) [unique, name: 'uq_user_tenant_phone']
    (tenant_id, national_id) [unique, name: 'uq_user_tenant_national_id']
    tenant_id
  }
  Note: 'CHECK: tenant_id chỉ được NULL khi role = ADMIN. Renter do Landlord tạo (UC14).'
}

Table PasswordResetToken {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  used_at timestamptz [note: 'Khác NULL = đã dùng, chỉ dùng một lần']
  created_at timestamptz [not null, default: `now()`]
  indexes { user_id }
  Note: 'Dùng cho cả đặt lại mật khẩu (UC02, UC10, UC25) và liên kết mời Renter đặt mật khẩu lần đầu (UC14).'
}

// ---------- DANH MỤC NGHIỆP VỤ ----------
Table Property {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name varchar(150) [not null]
  address varchar(255) [not null]
  description text
  electricity_unit_price decimal(12,0) [not null, note: 'đồng/kWh']
  water_unit_price decimal(12,0) [not null, note: 'đồng/m3']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes { tenant_id }
}

Table Room {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  property_id uuid [not null]
  room_code varchar(30) [not null]
  area_m2 decimal(6,2)
  base_price decimal(12,0) [not null]
  status room_status [not null, default: 'AVAILABLE']
  description text
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (property_id, room_code) [unique, name: 'uq_room_property_code']
    tenant_id
  }
}

Table Contract {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  room_id uuid [not null]
  renter_id uuid [not null, note: 'User có role = RENTER']
  start_date date [not null]
  end_date date [not null]
  monthly_rent decimal(12,0) [not null]
  deposit decimal(12,0) [not null, default: 0]
  terms text
  status contract_status [not null, default: 'ACTIVE']
  terminated_reason text [note: 'Lý do chấm dứt (UC15 PATCH /terminate); NULL với hợp đồng kết thúc bình thường']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { tenant_id  room_id  renter_id }
  Note: '''
    CHECK (end_date > start_date).
    Partial unique index (viết bằng SQL migration): mỗi phòng chỉ có một hợp đồng ACTIVE
    CREATE UNIQUE INDEX uq_contract_active_room ON contracts(room_id) WHERE status = 'ACTIVE';
  '''
}

// ---------- ĐIỆN NƯỚC, DỊCH VỤ, HÓA ĐƠN, THANH TOÁN ----------
Table MeterReading {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  room_id uuid [not null]
  billing_month date [not null, note: 'Ngày đầu tháng của kỳ']
  electricity_index decimal(10,2) [not null]
  water_index decimal(10,2) [not null]
  electricity_usage decimal(10,2) [not null]
  water_usage decimal(10,2) [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (room_id, billing_month) [unique, name: 'uq_meter_room_month']
    tenant_id
  }
}

Table Service {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  property_id uuid [not null]
  name varchar(100) [not null]
  unit varchar(30) [not null, note: 'tháng, xe, người...']
  unit_price decimal(12,0) [not null]
  is_active boolean [not null, default: true, note: 'false = ngừng sử dụng, không xóa']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (property_id, name) [unique, name: 'uq_service_property_name']
    tenant_id
  }
}

Table Invoice {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  contract_id uuid [not null]
  meter_reading_id uuid [not null, unique]
  billing_month date [not null]
  electricity_unit_price decimal(12,0) [not null, note: 'Đơn giá tại thời điểm lập']
  water_unit_price decimal(12,0) [not null, note: 'Đơn giá tại thời điểm lập']
  rent_amount decimal(12,0) [not null]
  electricity_amount decimal(12,0) [not null]
  water_amount decimal(12,0) [not null]
  service_amount decimal(12,0) [not null, default: 0]
  total_amount decimal(12,0) [not null, note: '= rent + electricity + water + service']
  status invoice_status [not null, default: 'UNPAID']
  issue_date date [not null]
  due_date date [not null]
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (contract_id, billing_month) [unique, name: 'uq_invoice_contract_month']
    tenant_id
    status
  }
}

Table InvoiceLineItem {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  invoice_id uuid [not null]
  service_id uuid [not null]
  service_name varchar(100) [not null, note: 'Sao chép từ Service tại thời điểm lập']
  unit varchar(30) [not null]
  unit_price decimal(12,0) [not null]
  quantity decimal(8,2) [not null]
  amount decimal(12,0) [not null, note: '= unit_price x quantity']
  indexes { invoice_id  tenant_id }
  Note: 'CHECK (quantity > 0). Thay cho cột other_fees.'
}

Table Payment {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  invoice_id uuid [not null]
  order_code bigint [not null, unique, note: 'Mã đơn gửi payOS, dùng đối chiếu Webhook']
  payment_link_id varchar(100)
  amount decimal(12,0) [not null]
  status payment_status [not null, default: 'PENDING']
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes { invoice_id  tenant_id }
}

// ---------- HỖ TRỢ ----------
Table Notification {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  user_id uuid [not null]
  type varchar(30) [not null, note: 'NEW_INVOICE, PAYMENT_RESULT, NEW_SUPPORT_REQUEST...']
  title varchar(150) [not null]
  content text [not null]
  entity_id uuid
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, is_read)
    tenant_id
  }
}

Table AuditLog {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  user_id uuid [not null]
  source audit_source [not null]
  action_type varchar(50) [not null, note: 'Tên function nghiệp vụ, ví dụ createInvoice']
  payload jsonb [not null]
  status audit_status [not null, default: 'PROPOSED']
  created_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz
  executed_at timestamptz
  indexes { tenant_id  user_id  created_at }
  Note: 'Chỉ thêm (append-only): app_user chỉ có quyền INSERT và SELECT.'
}

Table SupportRequest {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  renter_id uuid [not null, note: 'User có role = RENTER']
  type support_type [not null]
  title varchar(150) [not null]
  content text [not null]
  status support_status [not null, default: 'OPEN']
  response text
  responded_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { tenant_id  renter_id  (tenant_id, status) }
  Note: 'Renter gửi (UC33), Landlord phản hồi và đổi trạng thái (UC20).'
}

// ---------- QUAN HỆ ----------
Ref: Tenant.plan_id > Plan.id
Ref: User.tenant_id > Tenant.id
Ref: PasswordResetToken.user_id > User.id
Ref: Property.tenant_id > Tenant.id
Ref: Room.tenant_id > Tenant.id
Ref: Room.property_id > Property.id
Ref: Contract.tenant_id > Tenant.id
Ref: Contract.room_id > Room.id
Ref: Contract.renter_id > User.id
Ref: MeterReading.tenant_id > Tenant.id
Ref: MeterReading.room_id > Room.id
Ref: Service.tenant_id > Tenant.id
Ref: Service.property_id > Property.id
Ref: Invoice.tenant_id > Tenant.id
Ref: Invoice.contract_id > Contract.id
Ref: Invoice.meter_reading_id - MeterReading.id
Ref: InvoiceLineItem.tenant_id > Tenant.id
Ref: InvoiceLineItem.invoice_id > Invoice.id [delete: cascade]
Ref: InvoiceLineItem.service_id > Service.id [delete: restrict]
Ref: Payment.tenant_id > Tenant.id
Ref: Payment.invoice_id > Invoice.id
Ref: Notification.tenant_id > Tenant.id
Ref: Notification.user_id > User.id
Ref: AuditLog.tenant_id > Tenant.id
Ref: AuditLog.user_id > User.id
Ref: SupportRequest.tenant_id > Tenant.id
Ref: SupportRequest.renter_id > User.id