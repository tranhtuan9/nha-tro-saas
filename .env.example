# ---- Chung ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---- PostgreSQL ----
# Role owner: chỉ dùng cho migration và seed
DATABASE_URL=postgresql://nha_tro_owner:change_me@localhost:5432/nha_tro?schema=public
# Role app_user: API nghiệp vụ (bị RLS)
APP_DATABASE_URL=postgresql://app_user:change_me@localhost:5432/nha_tro?schema=public
# Role app_system: chỉ module auth, webhook payOS, admin (BYPASSRLS)
SYSTEM_DATABASE_URL=postgresql://app_system:change_me@localhost:5432/nha_tro?schema=public

# ---- Xác thực ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
RESET_TOKEN_EXPIRES_MINUTES=30
INVITE_TOKEN_EXPIRES_HOURS=48

# ---- Gói dịch vụ mặc định ----
DEFAULT_PLAN_NAME=Cơ bản
TRIAL_DAYS=14

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- payOS ----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL công khai (ngrok hoặc Cloudflare Tunnel) trỏ về /api/webhooks/payos
PAYOS_WEBHOOK_URL=

# ---- Email (Nodemailer) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quản lý nhà trọ <no-reply@example.com>"