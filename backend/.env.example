# ---- Chung ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Múi giờ nghiệp vụ (ranh giới tháng của kỳ chỉ số điện nước)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ---- PostgreSQL ----
# Role owner: chỉ dùng cho migration và seed
DATABASE_URL=postgresql://nha_tro_owner:change_me@localhost:5432/nha_tro?schema=public
# Role app_user: API nghiệp vụ (bị RLS)
APP_DATABASE_URL=postgresql://app_user:change_me@localhost:5432/nha_tro?schema=public
# Role app_system: chỉ module auth, webhook payOS, admin (BYPASSRLS)
SYSTEM_DATABASE_URL=postgresql://app_system:change_me@localhost:5432/nha_tro?schema=public

# ---- Xác thực ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
RESET_TOKEN_EXPIRES_MINUTES=30
INVITE_TOKEN_EXPIRES_HOURS=48

# ---- Gói dịch vụ mặc định ----
DEFAULT_PLAN_NAME=Cơ bản
TRIAL_DAYS=14

# ---- Seed & Demo ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me
DEMO_PASSWORD=123456

# ---- Nghiệp vụ hóa đơn & Thanh toán ----
# Hạn thanh toán mặc định (số ngày kể từ ngày lập hóa đơn)
INVOICE_DUE_DAYS=10
# Thời gian hiệu lực của link thanh toán payOS (phút)
PAYMENT_LINK_TTL_MINUTES=30

# ---- Google Gemini & AI Assistant ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Thời gian sống của đề xuất thao tác AI chờ duyệt (phút)
AI_PROPOSAL_TTL_MINUTES=15
# Timeout mỗi lượt gọi tool/model (ms)
AI_TIMEOUT_MS=15000
# Tổng thời gian tối đa cho một phiên xử lý AI (ms)
AI_TOTAL_TIMEOUT_MS=30000
# Số vòng gọi tool tối đa cho mỗi yêu cầu AI
AI_MAX_TOOL_ROUNDS=3

# ---- payOS ----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL công khai (ngrok) trỏ về /api/webhooks/payos
PAYOS_WEBHOOK_URL=

# ---- Email (Nodemailer) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Quản lý nhà trọ <no-reply@example.com>"