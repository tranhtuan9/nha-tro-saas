generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

enum UserRole {
  ADMIN
  LANDLORD
  RENTER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  LOCKED

  @@map("user_status")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE

  @@map("room_status")
}

enum ContractStatus {
  ACTIVE
  ENDED
  TERMINATED

  @@map("contract_status")
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED

  @@map("payment_status")
}

enum AuditSource {
  USER
  AI

  @@map("audit_source")
}

enum AuditStatus {
  PROPOSED
  CONFIRMED
  REJECTED
  EXECUTED
  FAILED

  @@map("audit_status")
}

enum SupportType {
  COMPLAINT
  REPAIR
  OTHER

  @@map("support_type")
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("support_status")
}

// ==================== MODELS ====================

// ---------- NỀN TẢNG SAAS ----------

model Plan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @unique @db.VarChar(100)
  maxProperties Int      @map("max_properties")
  maxRooms      Int      @map("max_rooms")
  price         Decimal  @db.Decimal(12, 0)
  durationDays  Int      @map("duration_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String       @db.VarChar(150)
  planId            String       @map("plan_id") @db.Uuid
  status            TenantStatus @default(ACTIVE)
  subscriptionStart DateTime     @map("subscription_start") @db.Date
  subscriptionEnd   DateTime     @map("subscription_end") @db.Date
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz

  plan             Plan              @relation(fields: [planId], references: [id])
  users            User[]
  properties       Property[]
  rooms            Room[]
  contracts        Contract[]
  meterReadings    MeterReading[]
  services         Service[]
  invoices         Invoice[]
  invoiceLineItems InvoiceLineItem[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  supportRequests  SupportRequest[]

  @@map("tenants")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?    @map("tenant_id") @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(150)
  phone        String?    @db.VarChar(20)
  nationalId   String?    @map("national_id") @db.VarChar(20)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant?              @relation(fields: [tenantId], references: [id])
  passwordResetTokens PasswordResetToken[]
  contracts           Contract[]           @relation("RenterContracts")
  notifications       Notification[]
  auditLogs           AuditLog[]
  supportRequests     SupportRequest[]     @relation("RenterSupportRequests")

  @@unique([tenantId, phone], name: "uq_user_tenant_phone")
  @@unique([tenantId, nationalId], name: "uq_user_tenant_national_id")
  @@index([tenantId])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- DANH MỤC NGHIỆP VỤ ----------

model Property {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  name                 String   @db.VarChar(150)
  address              String   @db.VarChar(255)
  description          String?  @db.Text
  electricityUnitPrice Decimal  @map("electricity_unit_price") @db.Decimal(12, 0)
  waterUnitPrice       Decimal  @map("water_unit_price") @db.Decimal(12, 0)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  rooms    Room[]
  services Service[]

  @@index([tenantId])
  @@map("properties")
}

model Room {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  propertyId  String     @map("property_id") @db.Uuid
  roomCode    String     @map("room_code") @db.VarChar(30)
  areaM2      Decimal?   @map("area_m2") @db.Decimal(6, 2)
  basePrice   Decimal    @map("base_price") @db.Decimal(12, 0)
  status      RoomStatus @default(AVAILABLE)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  property      Property       @relation(fields: [propertyId], references: [id])
  contracts     Contract[]
  meterReadings MeterReading[]

  @@unique([propertyId, roomCode], name: "uq_room_property_code")
  @@index([tenantId])
  @@map("rooms")
}

model Contract {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  roomId      String         @map("room_id") @db.Uuid
  renterId    String         @map("renter_id") @db.Uuid
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  monthlyRent Decimal        @map("monthly_rent") @db.Decimal(12, 0)
  deposit     Decimal        @default(0) @db.Decimal(12, 0)
  terms       String?        @db.Text
  status      ContractStatus @default(ACTIVE)
  terminatedReason String?   @map("terminated_reason") @db.Text
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  room     Room      @relation(fields: [roomId], references: [id])
  renter   User      @relation("RenterContracts", fields: [renterId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([roomId])
  @@index([renterId])
  @@map("contracts")
}

// ---------- ĐIỆN NƯỚC, DỊCH VỤ, HÓA ĐƠN, THANH TOÁN ----------

model MeterReading {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  roomId           String   @map("room_id") @db.Uuid
  billingMonth     DateTime @map("billing_month") @db.Date
  electricityIndex Decimal  @map("electricity_index") @db.Decimal(10, 2)
  waterIndex       Decimal  @map("water_index") @db.Decimal(10, 2)
  electricityUsage Decimal  @map("electricity_usage") @db.Decimal(10, 2)
  waterUsage       Decimal  @map("water_usage") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  room    Room     @relation(fields: [roomId], references: [id])
  // Một chỉ số có thể gắn nhiều hóa đơn theo lịch sử (hóa đơn hủy rồi lập lại);
  // hành vi do partial unique index uq_invoice_active_meter_reading quyết định.
  invoices Invoice[]

  @@unique([roomId, billingMonth], name: "uq_meter_room_month")
  @@index([tenantId])
  @@map("meter_readings")
}

model Service {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  name       String   @db.VarChar(100)
  unit       String   @db.VarChar(30)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  property         Property          @relation(fields: [propertyId], references: [id])
  invoiceLineItems InvoiceLineItem[]

  @@unique([propertyId, name], name: "uq_service_property_name")
  @@index([tenantId])
  @@map("services")
}

model Invoice {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  contractId           String        @map("contract_id") @db.Uuid
  meterReadingId       String        @map("meter_reading_id") @db.Uuid
  billingMonth         DateTime      @map("billing_month") @db.Date
  electricityUnitPrice Decimal       @map("electricity_unit_price") @db.Decimal(12, 0)
  waterUnitPrice       Decimal       @map("water_unit_price") @db.Decimal(12, 0)
  rentAmount           Decimal       @map("rent_amount") @db.Decimal(12, 0)
  electricityAmount    Decimal       @map("electricity_amount") @db.Decimal(12, 0)
  waterAmount          Decimal       @map("water_amount") @db.Decimal(12, 0)
  serviceAmount        Decimal       @default(0) @map("service_amount") @db.Decimal(12, 0)
  totalAmount          Decimal       @map("total_amount") @db.Decimal(12, 0)
  status               InvoiceStatus @default(UNPAID)
  issueDate            DateTime      @map("issue_date") @db.Date
  dueDate              DateTime      @map("due_date") @db.Date
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  contract     Contract          @relation(fields: [contractId], references: [id])
  meterReading MeterReading      @relation(fields: [meterReadingId], references: [id])
  lineItems    InvoiceLineItem[]
  payments     Payment[]

  // Cho phép hủy rồi lập lại: mỗi hợp đồng một hóa đơn CHƯA HỦY mỗi kỳ,
  // mỗi chỉ số một hóa đơn CHƯA HỦY (viết bằng SQL migration):
  //   uq_invoice_active_contract_month  UNIQUE (contract_id, billing_month) WHERE status <> 'CANCELLED'
  //   uq_invoice_active_meter_reading   UNIQUE (meter_reading_id) WHERE status <> 'CANCELLED'
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  serviceId   String  @map("service_id") @db.Uuid
  serviceName String  @map("service_name") @db.VarChar(100)
  unit        String  @db.VarChar(30)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 0)
  quantity    Decimal @db.Decimal(8, 2)
  amount      Decimal @db.Decimal(12, 0)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([tenantId])
  @@map("invoice_line_items")
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  orderCode     BigInt        @unique @map("order_code")
  paymentLinkId String?       @map("payment_link_id") @db.VarChar(100)
  // SDK payOS chỉ trả checkoutUrl khi tạo link; lưu lại để trả client khi PENDING còn hạn.
  checkoutUrl   String?       @map("checkout_url") @db.Text
  amount        Decimal       @db.Decimal(12, 0)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([tenantId])
  @@map("payments")
}

// ---------- HỖ TRỢ, THÔNG BÁO & AUDIT ----------

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(30)
  title     String   @db.VarChar(150)
  content   String   @db.Text
  entityId  String?  @map("entity_id") @db.Uuid
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([tenantId])
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  source      AuditSource
  actionType  String      @map("action_type") @db.VarChar(50)
  payload     Json        @db.JsonB
  status      AuditStatus @default(PROPOSED)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  confirmedAt DateTime?   @map("confirmed_at") @db.Timestamptz
  executedAt  DateTime?   @map("executed_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

model SupportRequest {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  renterId    String        @map("renter_id") @db.Uuid
  type        SupportType
  title       String        @db.VarChar(150)
  content     String        @db.Text
  status      SupportStatus @default(OPEN)
  response    String?       @db.Text
  respondedAt DateTime?     @map("responded_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  renter User   @relation("RenterSupportRequests", fields: [renterId], references: [id])

  @@index([tenantId])
  @@index([renterId])
  @@index([tenantId, status])
  @@map("support_requests")
}
